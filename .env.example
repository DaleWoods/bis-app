# --- Server -----------------------------------------------------------------
NODE_ENV=development
PORT=4000
PUBLIC_WEB_ORIGIN=http://localhost:5173
PUBLIC_API_ORIGIN=http://localhost:4000

# --- Database ---------------------------------------------------------------
# Production (Azure Database for PostgreSQL):
#   DB_DRIVER=postgres
#   DATABASE_URL=postgres://user:password@host:5432/bis
#   DATABASE_SSL=true
# Local development defaults to a SQLite file, so nothing needs installing.
DB_DRIVER=sqlite
SQLITE_FILE=./data/bis.db

# --- Deployment switches ----------------------------------------------------
# A fresh database has no members and sign-in requires one, so set this to the
# first administrator's email. Created as ADMIN on boot; also restores admin
# rights if they are ever lost.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=

# In email mode, lets someone not on the committee sign themselves in and be
# added as a scorer. Off by default: a new scorer's submissions count toward
# the average and the minimum-responses gate.
ALLOW_SELF_REGISTRATION=false

# Permits a SQLite file in a production build instead of PostgreSQL.
ALLOW_SQLITE=false

# '' (none) | base (committee placeholders) | demo (also a sample round).
# Only ever seeds a database with no rounds in it.
SEED_ON_BOOT=

# --- Auth -------------------------------------------------------------------
# email = pick your name from the committee list (internal tool, known group)
# entra = Microsoft 365 / Entra ID SSO
# dev   = alias of email, kept so older .env files keep working
AUTH_MODE=email
SESSION_SECRET=change-me-to-a-long-random-string
SESSION_TTL_HOURS=12
SESSION_COOKIE_SECURE=false

ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=http://localhost:4000/auth/callback
ENTRA_ALLOWED_EMAIL_DOMAINS=

# --- JIRA Cloud -------------------------------------------------------------
# Use a service account and an API token - never a personal login.
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=bis-service-account@example.com
JIRA_API_TOKEN=

# --- Email — SMTP (recommended: needs no IT approval) -----------------------
# Any provider works. Sign up, verify the one address you will send from, then:
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Only for an internal relay with a self-signed certificate. Leave true for
# any public provider.
SMTP_TLS_REJECT_UNAUTHORIZED=true

EMAIL_FROM=
EMAIL_FROM_NAME=Business Impact Scoring
EMAIL_REPLY_TO=
# false = compose and log messages without sending, for rehearsing the cadence
EMAIL_SEND_ENABLED=true
# smtp | graph | none. Auto-detected from what is configured.
EMAIL_PROVIDER=

# --- Email — Microsoft Graph (alternative to SMTP) --------------------------
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_SENDER_UPN=business-scoring@example.com
# false = render and log messages without sending, for rehearsing the cadence
GRAPH_SEND_ENABLED=false
